{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Humaan",
  "version": "0.0.1-alpha.1",
  "identifier": "ai.humaan.desktop",
  "mainBinaryName": "Humaan",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build",
    "beforeBundleCommand": "bun scripts/check-macos-icon.ts"
  },
  "app": {
    "windows": [
      {
        "title": "Humaan",
        "theme": "Dark",
        "backgroundColor": "#1a1a1a",
        "width": 1280,
        "height": 800,
        "maximized": true,
        "fullscreen": false,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../../../LICENSE": "LICENSE"
    },
    "icon": [
      "icons/Humaan.icon",
      "icons/legacy/icon.png",
      "icons/legacy/icon.icns"
    ]
  }
}
