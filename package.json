{
  "name": "humaan",
  "private": true,
  "scripts": {
    "version:sync": "bun scripts/sync-versions.ts",
    "version:check": "bun scripts/sync-versions.ts --check",
    "test:versions": "bun test scripts/sync-versions.test.ts",
    "dev:studio": "bun run --cwd apps/desktop tauri dev",
    "build:studio": "bun run --cwd apps/desktop tauri build",
    "build:cli": "bun run version:sync && cargo build -p humaan-cli --release --locked"
  }
}
